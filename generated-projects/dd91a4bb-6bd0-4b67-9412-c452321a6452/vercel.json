{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "express",
  "buildCommand": "npm run build",
  "functions": {
    "index.ts": {
      "includeFiles": "dist/**"
    },
    "api/blob-object.ts": {}
  },
  "rewrites": [
    {
      "source": "/objects/vercel/:path*",
      "destination": "/api/blob-object?path=:path*"
    }
  ]
}
