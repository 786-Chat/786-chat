# Copy to /etc/foodsafety-iot-gateway.env on HP2 and fill real values there.
# Never commit the real gateway token, MQTT password, or customer Wi-Fi password.

PEST_CONTROL_BASE_URL=https://YOUR-PEST-CONTROL-APP.example
FOODSAFETY_IOT_GATEWAY_TOKEN=CHANGE_ME

MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=CHANGE_ME
MQTT_PASSWORD=CHANGE_ME

# Multi-device mode (recommended)
# Subscribe to one or more trap topics. MQTT wildcards are supported.
MQTT_EVENT_TOPICS=+/trap

# Map each topic root (or full topic) to the registered Food Safety device ID.
# JSON or comma-separated alias=ID syntax are both accepted.
MQTT_DEVICE_MAP={"DEVICE1":"FS-MOUSE-000001","DEVICE2":"FS-MOUSE-000002","DEVICE3":"FS-MOUSE-000003","DEVICE4":"FS-MOUSE-000004"}

# Legacy single-device fallback. Kept for an existing DEVICE4/trap installation.
FOODSAFETY_DEVICE_ID=FS-MOUSE-000001
MQTT_EVENT_TOPIC=DEVICE4/trap
