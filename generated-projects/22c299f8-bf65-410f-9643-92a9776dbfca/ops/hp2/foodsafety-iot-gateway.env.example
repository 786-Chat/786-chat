# Copy to /etc/foodsafety-iot-gateway.env on HP2 and fill real values there.
# Never commit the real gateway token or MQTT password.

PEST_CONTROL_BASE_URL=https://YOUR-PEST-CONTROL-APP.example
FOODSAFETY_IOT_GATEWAY_TOKEN=CHANGE_ME
FOODSAFETY_DEVICE_ID=FS-MOUSE-000001

MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_EVENT_TOPIC=DEVICE4/trap
MQTT_USERNAME=CHANGE_ME
MQTT_PASSWORD=CHANGE_ME
