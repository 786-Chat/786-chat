{
  "version": 1,
  "capabilities": ["database", "authentication", "email", "api"],
  "providers": {
    "database": {
      "type": "neon",
      "driver": "@neondatabase/serverless",
      "env": ["DATABASE_URL"],
      "migration": "sql/migrations/001_initial.sql"
    },
    "authentication": {
      "type": "jwt",
      "library": "jose",
      "env": ["AUTH_SECRET"],
      "sessionCookie": "bean_house_session",
      "routes": [
        "/api/auth/register",
        "/api/auth/login",
        "/api/auth/logout",
        "/api/auth/session",
        "/api/auth/forgot-password",
        "/api/auth/reset-password",
        "/api/auth/verify-email"
      ]
    },
    "email": {
      "type": "resend",
      "library": "resend",
      "env": ["RESEND_API_KEY", "EMAIL_FROM"],
      "routes": ["/api/email"]
    },
    "api": {
      "basePath": "/api",
      "routes": [
        "/api/auth/register",
        "/api/auth/login",
        "/api/auth/logout",
        "/api/auth/session",
        "/api/auth/forgot-password",
        "/api/auth/reset-password",
        "/api/auth/verify-email",
        "/api/email"
      ]
    }
  }
}
