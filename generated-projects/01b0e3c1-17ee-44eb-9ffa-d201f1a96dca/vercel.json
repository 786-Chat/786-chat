{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/((?!assets/|fonts/|attached_assets/|favicon.ico|robots.txt|manifest.json).*)",
      "destination": "/index.html"
    }
  ]
}